# SQLite file, relative to prisma/schema.prisma. For Postgres later:
# DATABASE_URL="postgresql://user:pass@localhost:5432/impact_tracker"
DATABASE_URL="file:./dev.db"

# Optional (phase 3). The app works fully without it; AI features show as unavailable.
GEMINI_API_KEY=""

# List the seeded demo accounts on the sign-in page. Only for demos, never with real data.
DEMO_ACCOUNTS="1"
# Password for the seeded demo accounts (default: demo-password-2026).
# SEED_PASSWORD=""
