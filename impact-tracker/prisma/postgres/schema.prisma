model Parameter {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  definition  String  @default("")
  level       String // input | activity | output | outcome | impact
  unit        String  @default("")
