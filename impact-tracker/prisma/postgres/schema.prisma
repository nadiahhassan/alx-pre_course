  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  // admin (Global lead) | programme (programme team) | partner | viewer
  role         String    @default("viewer")
  // For partners: comms | gapp | marketing. Blank for others.
  team         String    @default("")
  passwordHash String    @default("")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  sessions           Session[]
  responsibilities   Responsibility[]
  risks              Risk[]
  spendEntries       SpendEntry[]
  ownedFocusAreas    FocusArea[] @relation("FocusAreaOwner")
  ownedProjects      Project[]   @relation("ProjectOwner")
  entries            Entry[]
  snapshots          Snapshot[]
  approvedParameters Parameter[] @relation("ParameterApprover")
  approvedEvidence   Evidence[]  @relation("EvidenceApprover")
}

// Signed-in sessions. Only a hash of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

